#!/system/bin/sh
# ==============================================================================
# FrenzyServer CLI - All-in-One Linux Server Engine Controller
# Optimized for Helio G99 (MT6789) - Tecno Pova 4 Pro
# Author: Muqsith (Frenzy)
# ==============================================================================

MODDIR="/data/adb/modules/frenzy_server"
[ ! -d "$MODDIR" ] && MODDIR="/data/adb/modules/frenzy_g99_server_fusion"

TOUCH_BIN="${MODDIR}/bin/touch_blocker"
TOUCH_LOG="/data/local/tmp/touch_blocker.log"
HTTPD_BIN="/data/adb/ksu/bin/busybox"
WEBROOT="${MODDIR}/webroot"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

TIER1_PKGS="
org.omnirom.omnijaws
org.omnirom.logcat
com.stevesoltys.seedvault
eu.chainfire.opendelta
eu.chainfire.opendelta.overlay.vanilla
eu.chainfire.opendelta.overlay.mt6789
com.google.android.flipendo
com.android.printspooler
com.android.deskclock
com.android.photopicker
com.android.providers.calendar
com.android.adservices.api
com.android.wallpaper
com.android.wallpaperbackup
com.android.wallpaper.livepicker
org.yaap.wallpaper.overlay.vanilla
com.android.cameraextensions
com.google.android.apps.googlecamera.fishfood
org.fdroid.fdroid
com.android.rkpdapp
com.android.nfc
com.mediatek.ims
com.mediatek.ims.overlay
com.mediatek.ims.overlay.telephony
com.android.imsserviceentitlement
com.android.cellbroadcastreceiver
com.android.cellbroadcastreceiver.module
com.android.cellbroadcastservice
"

show_banner() {
    echo -e "${CYAN}${BOLD}======================================================${NC}"
    echo -e "${CYAN}${BOLD}    ⚡ FRENZYSERVER ALL-IN-ONE LINUX SERVER ENGINE   ${NC}"
    echo -e "${CYAN}${BOLD}       Helio G99 (MT6789) | Droidspaces Host          ${NC}"
    echo -e "${CYAN}${BOLD}======================================================${NC}"
}

get_mem_kb() {
    grep "^$1:" /proc/meminfo 2>/dev/null | awk '{print $2}'
}

get_batt_temp() {
    if [ -f /sys/class/power_supply/battery/temp ]; then
        raw=$(cat /sys/class/power_supply/battery/temp)
        echo $((raw / 10))
    else
        echo 0
    fi
}

get_touch_event() {
    TOUCH_EVENT=$(grep -A 5 -i "mtk-tpd" /proc/bus/input/devices 2>/dev/null | grep -E -o "event[0-9]+" | head -n 1)
    [ -z "$TOUCH_EVENT" ] && TOUCH_EVENT="event3"
    echo "$TOUCH_EVENT"
}

get_current_mode() {
    if [ -f /dev/frenzy_tier2_active ]; then
        echo "tier2"
    else
        LPID=$(pidof com.android.launcher3 2>/dev/null)
        if [ -n "$LPID" ] && grep -q "State:.*T (stopped)" "/proc/$LPID/status" 2>/dev/null; then
            echo "tier2"
        else
            COUNT=0
            for pkg in org.omnirom.omnijaws com.mediatek.ims com.android.nfc; do
                pm list packages -d 2>/dev/null | grep -q "${pkg}$" && COUNT=$((COUNT + 1))
            done
            if [ "$COUNT" -ge 2 ]; then
                echo "tier1"
            else
                echo "normal"
            fi
        fi
    fi
}

get_vpn_ip() {
    ip -4 addr show tun1 2>/dev/null | grep -oE "inet [0-9.]+" | awk '{print $2}'
}

cmd_help() {
    show_banner
    echo -e "${BOLD}FrenzyServer Command-Line Interface Manual${NC}\n"
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  frenzy-server [command] [options]\n"
    echo -e "${BOLD}CORE COMMANDS:${NC}"
    echo -e "  ${GREEN}status${NC}                  Show real-time RAM, thermal, container & hardware status"
    echo -e "  ${GREEN}help${NC}                    Show this help manual and usage guide"
    echo -e "  ${GREEN}json${NC}                    Dump complete system metrics in JSON format (for WebUI/API)\n"
    echo -e "${BOLD}SERVER MODES (TIERS):${NC}"
    echo -e "  ${GREEN}mode normal${NC}             Restore standard phone mode (unfreeze launcher, systemui & apps)"
    echo -e "  ${GREEN}mode tier1${NC}              Activate Tier 1 Smart Debloat (~1.5GB RAM saved, keeps UI)"
    echo -e "  ${GREEN}mode tier2${NC}              Activate Tier 2 Extreme Headless (Zero GUI, >5.5GB RAM for Server)\n"
    echo -e "${BOLD}INTEGRATED SERVICES:${NC}"
    echo -e "  ${GREEN}vpn status${NC}              Check Tailscale VPN tunnel and IP address"
    echo -e "  ${GREEN}vpn connect${NC}             Connect Tailscale VPN tunnel (broadcast)"
    echo -e "  ${GREEN}vpn disconnect${NC}          Disconnect Tailscale VPN tunnel (broadcast)"
    echo -e "  ${GREEN}vpn open${NC}                Launch Tailscale application on screen\n"
    echo -e "  ${GREEN}droidspaces status${NC}      Check Droidspaces container & services"
    echo -e "  ${GREEN}droidspaces open${NC}        Launch Droidspaces application on screen"
    echo -e "  ${GREEN}droidspaces restart${NC}     Restart Droidspaces container instance\n"
    echo -e "${BOLD}HARDWARE & MEMORY CONTROLS:${NC}"
    echo -e "  ${GREEN}touch [block|unblock]${NC}   Toggle physical touchscreen ghost-touch shield"
    echo -e "  ${GREEN}trim${NC}                    Drop Linux page caches & compact kernel memory"
    echo -e "  ${GREEN}fp clean${NC}                Delete crash dump tombstones from storage"
    echo -e "  ${GREEN}web [start|stop|status]${NC} Manage local WebUI HTTP server on port 8888\n"
    echo -e "${BOLD}NAVIGATION & DISPLAY CONTROLS:${NC}"
    echo -e "  ${GREEN}back${NC}                    Send Android Back keyevent (4) to screen"
    echo -e "  ${GREEN}home${NC}                    Refocus FrenzyServer WebUI dashboard on screen\n"
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo -e "  adb shell su -c 'frenzy-server status'"
    echo -e "  adb shell su -c 'frenzy-server mode tier2'"
    echo -e "  adb shell su -c 'frenzy-server back'"
    echo -e "  adb shell su -c 'frenzy-server vpn connect'"
    echo -e "  adb shell su -c 'frenzy-server trim'"
    echo -e "${CYAN}======================================================${NC}"
}

cmd_status() {
    show_banner
    
    TOTAL_KB=$(get_mem_kb "MemTotal")
    FREE_KB=$(get_mem_kb "MemFree")
    AVAIL_KB=$(get_mem_kb "MemAvailable")
    CACHED_KB=$(get_mem_kb "Cached")
    
    TOTAL_MB=$((TOTAL_KB / 1024))
    FREE_MB=$((FREE_KB / 1024))
    AVAIL_MB=$((AVAIL_KB / 1024))
    USED_MB=$((TOTAL_MB - AVAIL_MB))
    BATT_TEMP=$(get_batt_temp)
    MODE=$(get_current_mode)
    
    echo -e "${BOLD}[1] RAM & Memory Health:${NC}"
    echo -e "  • Total RAM     : ${GREEN}${TOTAL_MB} MB${NC} (~8 GB)"
    echo -e "  • Used RAM      : ${YELLOW}${USED_MB} MB${NC}"
    echo -e "  • Free Physical : ${GREEN}${FREE_MB} MB${NC}"
    echo -e "  • Available RAM : ${GREEN}${BOLD}${AVAIL_MB} MB${NC} (Available for Server/LXC)"
    echo -e "  • Battery Temp  : ${GREEN}${BATT_TEMP}°C${NC} (Smart Guard Limit: 47°C)"
    
    echo -e "\n${BOLD}[2] Server Mode (Current):${NC}"
    case "$MODE" in
        tier2)
            echo -e "  • Active Mode   : ${CYAN}${BOLD}TIER 2 (Extreme Headless Server)${NC}"
            echo -e "  • Screen State  : Deep Sleep (Zero GUI / Controlled via PC)"
            ;;
        tier1)
            echo -e "  • Active Mode   : ${GREEN}${BOLD}TIER 1 (Smart Headless Debloat)${NC}"
            echo -e "  • Screen State  : Normal Android Launcher (Bloat Apps Frozen)"
            ;;
        *)
            echo -e "  • Active Mode   : ${YELLOW}NORMAL (Consumer Phone Mode)${NC}"
            ;;
    esac
    
    # Check Camera Services
    CAM_HAL=$(getprop init.svc.camerahalserver 2>/dev/null)
    echo -e "\n${BOLD}[3] Hardware Subsystems:${NC}"
    if [ "$CAM_HAL" = "stopped" ] || [ -z "$CAM_HAL" ]; then
        echo -e "  • Camera HALs   : ${GREEN}DISABLED / STOPPED${NC} (~200MB saved)"
    else
        echo -e "  • Camera HALs   : ${RED}RUNNING${NC}"
    fi
    
    # Check Fingerprint
    FP_HAL=$(getprop init.svc.vendor.fps_hal 2>/dev/null)
    if [ "$FP_HAL" = "stopped" ] || [ -z "$FP_HAL" ]; then
        echo -e "  • Fingerprint   : ${GREEN}KILLED & SHIELDED${NC} (No crash loops)"
    else
        echo -e "  • Fingerprint   : ${RED}ACTIVE / POLLING${NC}"
    fi
    
    # Check Touch Blocker
    if pidof touch_blocker >/dev/null 2>&1; then
        echo -e "  • Ghost Touch   : ${GREEN}BLOCKED (PID: $(pidof touch_blocker))${NC}"
    else
        echo -e "  • Ghost Touch   : ${YELLOW}UNBLOCKED (Touch Active)${NC}"
    fi
    
    # Check Integrated Services (Tailscale & Droidspaces)
    echo -e "\n${BOLD}[4] Integrated Services:${NC}"
    VPN_IP=$(get_vpn_ip)
    if [ -n "$VPN_IP" ]; then
        echo -e "  • Tailscale VPN : ${GREEN}CONNECTED${NC} (IP: ${BOLD}${VPN_IP}${NC}, dev tun1)"
    else
        echo -e "  • Tailscale VPN : ${YELLOW}DISCONNECTED${NC}"
    fi
    
    if pidof droidspaces >/dev/null 2>&1; then
        echo -e "  • Droidspaces   : ${GREEN}RUNNING (Debian 13)${NC} (PIDs: $(pidof droidspaces))"
        pidof nginx >/dev/null 2>&1 && echo -e "    └─ Nginx      : ${GREEN}ACTIVE${NC}"
        (pidof node >/dev/null 2>&1 || ps -ef | grep -q "pm2") && echo -e "    └─ PM2/Node   : ${GREEN}ACTIVE${NC}"
    else
        echo -e "  • Droidspaces   : ${RED}STOPPED${NC}"
    fi
    
    # Local WebUI Server
    if pgrep -f "httpd" >/dev/null 2>&1; then
        WLAN_IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oE "inet [0-9.]+" | awk '{print $2}')
        echo -e "  • WebUI Server  : ${GREEN}RUNNING (Port 8888)${NC}"
        echo -e "    └─ LAN URL    : http://${WLAN_IP:-127.0.0.1}:8888"
        [ -n "$VPN_IP" ] && echo -e "    └─ Tailscale  : http://${VPN_IP}:8888"
    else
        echo -e "  • WebUI Server  : ${YELLOW}STOPPED${NC} (KernelSU Manager only)"
    fi
    
    echo -e "${CYAN}======================================================${NC}"
}

cmd_mode() {
    target="$1"
    show_banner
    case "$target" in
        tier1|enable)
            echo -e "${YELLOW}[*] Switching to TIER 1: Smart Headless Debloat...${NC}"
            
            # 1. If exiting Tier 2: restore physical display hardware & unfreeze GUI
            rm -f /dev/frenzy_tier2_active
            chmod 644 /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            chown system:system /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            echo 200 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            
            SPID=$(pidof com.android.systemui 2>/dev/null)
            [ -n "$SPID" ] && kill -CONT $SPID 2>/dev/null
            killall -9 com.android.launcher3 2>/dev/null
            
            # Fallback if unfreeze needs package manager re-check
            pm enable com.android.launcher3 >/dev/null 2>&1
            pm enable com.android.systemui >/dev/null 2>&1
            [ -z "$SPID" ] && am start-service -n com.android.systemui/.SystemUIService >/dev/null 2>&1
            
            # Wake display and restore navigation
            cmd power wakeup 2>/dev/null
            NAV_MODE=$(cat "${MODDIR}/nav_mode" 2>/dev/null)
            [ -z "$NAV_MODE" ] || [ "$NAV_MODE" = "null" ] && NAV_MODE="2"
            settings put secure navigation_mode "$NAV_MODE" 2>/dev/null
            if [ "$NAV_MODE" = "0" ]; then
                cmd overlay enable com.android.internal.systemui.navbar.threebutton 2>/dev/null
            else
                cmd overlay enable com.android.internal.systemui.navbar.gestural 2>/dev/null
            fi
            am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
            
            # 2. Stop Camera services
            stop camerahalserver 2>/dev/null
            stop cameraserver 2>/dev/null
            setprop ctl.stop camerahalserver 2>/dev/null
            setprop ctl.stop cameraserver 2>/dev/null
            
            # 3. Freeze 29 bloat packages
            COUNT=0
            for pkg in $TIER1_PKGS; do
                if pm list packages 2>/dev/null | grep -q "${pkg}$"; then
                    pm disable-user --user 0 "$pkg" >/dev/null 2>&1
                    COUNT=$((COUNT + 1))
                fi
            done
            
            # 4. Drop caches & compact kernel memory
            echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
            echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
            
            AVAIL_MB=$(( $(get_mem_kb "MemAvailable") / 1024 ))
            echo -e "${GREEN}✅ TIER 1 ACTIVE: ${COUNT} apps frozen, Camera halted, UI preserved.${NC}"
            echo -e "   • Available RAM : ${AVAIL_MB} MB"
            ;;
            
        tier2|extreme|headless)
            echo -e "${CYAN}[*] Switching to TIER 2: EXTREME HEADLESS SERVER MODE...${NC}"
            
            # 0. Save current navigation mode
            CURR_NAV=$(settings get secure navigation_mode 2>/dev/null)
            [ -n "$CURR_NAV" ] && [ "$CURR_NAV" != "null" ] && echo "$CURR_NAV" > "${MODDIR}/nav_mode"
            
            # 1. Stop Camera HALs & freeze all Tier 1 bloat
            stop camerahalserver 2>/dev/null
            stop cameraserver 2>/dev/null
            setprop ctl.stop camerahalserver 2>/dev/null
            setprop ctl.stop cameraserver 2>/dev/null
            for pkg in $TIER1_PKGS; do
                pm disable-user --user 0 "$pkg" >/dev/null 2>&1
            done
            
            # 2. Hardware Display Sleep & Backlight Lock first (pauses activities cleanly)
            cmd power sleep --disable-wakelocks 2>/dev/null
            echo 0 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            chown root:root /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            chmod 000 /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            
            # 3. Freeze Android Graphical Shell via Linux SIGSTOP (Zero CPU/RAM overhead, NO FallbackHome loop!)
            echo -e "[*] Freezing com.android.launcher3 & com.android.systemui via SIGSTOP..."
            LPID=$(pidof com.android.launcher3 2>/dev/null)
            SPID=$(pidof com.android.systemui 2>/dev/null)
            [ -n "$LPID" ] && kill -STOP $LPID 2>/dev/null
            [ -n "$SPID" ] && kill -STOP $SPID 2>/dev/null
            touch /dev/frenzy_tier2_active
            
            # 4. Touchscreen Ghost Shield
            cmd_touch "block" >/dev/null 2>&1
            
            # 5. Ensure Web Server on port 8888 (for PC browser dashboard)
            cmd_web "start" >/dev/null 2>&1
            
            # 6. Tailscale VPN Keepalive
            if ! ip link show tun1 >/dev/null 2>&1; then
                cmd_vpn "connect" >/dev/null 2>&1
            fi
            
            # 7. Drop caches & compact kernel memory
            echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
            echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
            
            AVAIL_MB=$(( $(get_mem_kb "MemAvailable") / 1024 ))
            WLAN_IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oE "inet [0-9.]+" | awk '{print $2}')
            VPN_IP=$(get_vpn_ip)
            echo -e "${GREEN}🎉 TIER 2 EXTREME HEADLESS ACTIVE!${NC}"
            echo -e "   • Available RAM  : ${GREEN}${BOLD}${AVAIL_MB} MB${NC} (>5.5 GB dedicated to Linux/Server)"
            echo -e "   • Android GUI    : Completely Frozen via SIGSTOP (Zero GUI Overhead)"
            echo -e "   • Display State  : Hardware Screen Locked OFF (Controlled 100% via PC)"
            echo -e "   • PC LAN Access  : http://${WLAN_IP:-127.0.0.1}:8888"
            [ -n "$VPN_IP" ] && echo -e "   • Tailscale Web  : http://${VPN_IP}:8888"
            echo -e "   • LXC Container  : Droidspaces Debian 13 ACTIVE"
            ;;
            
        normal|disable|restore)
            echo -e "${YELLOW}[*] Restoring to NORMAL Consumer Phone Mode...${NC}"
            
            # 1. Remove Tier 2 marker & restore hardware backlight permissions
            rm -f /dev/frenzy_tier2_active
            chmod 644 /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            chown system:system /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            echo 200 > /sys/class/leds/lcd-backlight/brightness 2>/dev/null
            
            # 2. Unfreeze SystemUI & cleanly restart Launcher3
            SPID=$(pidof com.android.systemui 2>/dev/null)
            [ -n "$SPID" ] && kill -CONT $SPID 2>/dev/null
            killall -9 com.android.launcher3 2>/dev/null
            
            # Fallback if processes were killed or disabled previously
            pm enable com.android.launcher3 >/dev/null 2>&1
            pm enable com.android.systemui >/dev/null 2>&1
            [ -z "$SPID" ] && am start-service -n com.android.systemui/.SystemUIService >/dev/null 2>&1
            
            # 3. Wake screen & restore navigation mode
            cmd power wakeup 2>/dev/null
            NAV_MODE=$(cat "${MODDIR}/nav_mode" 2>/dev/null)
            [ -z "$NAV_MODE" ] || [ "$NAV_MODE" = "null" ] && NAV_MODE="2"
            settings put secure navigation_mode "$NAV_MODE" 2>/dev/null
            if [ "$NAV_MODE" = "0" ]; then
                cmd overlay enable com.android.internal.systemui.navbar.threebutton 2>/dev/null
            else
                cmd overlay enable com.android.internal.systemui.navbar.gestural 2>/dev/null
            fi
            
            # 4. Unfreeze all Tier 1 packages
            COUNT=0
            for pkg in $TIER1_PKGS; do
                if pm list packages -d 2>/dev/null | grep -q "${pkg}$"; then
                    pm enable "$pkg" >/dev/null 2>&1
                    COUNT=$((COUNT + 1))
                fi
            done
            
            # 5. Restart camera services
            start camerahalserver 2>/dev/null
            start cameraserver 2>/dev/null
            
            # 6. Bring home screen up
            am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
            
            AVAIL_MB=$(( $(get_mem_kb "MemAvailable") / 1024 ))
            echo -e "${GREEN}✅ Normal mode restored! Launcher, SystemUI, Navbar & ${COUNT} apps re-enabled.${NC}"
            echo -e "   • Available RAM : ${AVAIL_MB} MB"
            ;;
            
        *)
            echo -e "${RED}Invalid mode. Usage: frenzy-server mode [normal|tier1|tier2]${NC}"
            exit 1
            ;;
    esac
    echo -e "${CYAN}======================================================${NC}"
}

cmd_vpn() {
    sub="$1"
    case "$sub" in
        connect)
            echo -e "${YELLOW}[*] Connecting Tailscale VPN tunnel...${NC}"
            am broadcast -a com.tailscale.ipn.CONNECT_VPN -n com.tailscale.ipn/.IPNReceiver >/dev/null 2>&1
            sleep 2
            VPN_IP=$(get_vpn_ip)
            if [ -n "$VPN_IP" ]; then
                echo -e "${GREEN}✅ Tailscale VPN CONNECTED (IP: ${BOLD}${VPN_IP}${NC}).${NC}"
            else
                echo -e "${YELLOW}[*] Broadcast sent. Tunnel establishing...${NC}"
            fi
            ;;
        disconnect)
            echo -e "${YELLOW}[*] Disconnecting Tailscale VPN tunnel...${NC}"
            am broadcast -a com.tailscale.ipn.DISCONNECT_VPN -n com.tailscale.ipn/.IPNReceiver >/dev/null 2>&1
            sleep 1
            echo -e "${GREEN}✅ Tailscale VPN disconnected.${NC}"
            ;;
        open)
            echo -e "${YELLOW}[*] Launching Tailscale application...${NC}"
            am start -n com.tailscale.ipn/.MainActivity >/dev/null 2>&1
            echo -e "${GREEN}✅ Tailscale opened on screen.${NC}"
            ;;
        status|*)
            VPN_IP=$(get_vpn_ip)
            if [ -n "$VPN_IP" ]; then
                echo -e "Tailscale VPN: ${GREEN}CONNECTED${NC} (IP: ${VPN_IP}, Interface: tun1)"
            else
                echo -e "Tailscale VPN: ${YELLOW}DISCONNECTED${NC}"
            fi
            ;;
    esac
}

cmd_droidspaces() {
    sub="$1"
    case "$sub" in
        open)
            echo -e "${YELLOW}[*] Launching Droidspaces application...${NC}"
            am start -n com.droidspaces.app/.MainActivity >/dev/null 2>&1
            echo -e "${GREEN}✅ Droidspaces opened on screen.${NC}"
            ;;
        restart)
            echo -e "${YELLOW}[*] Restarting Droidspaces container (my-container)...${NC}"
            /data/local/Droidspaces/bin/droidspaces --config /data/local/Droidspaces/Containers/my-container/container.config restart >/dev/null 2>&1
            sleep 2
            if pidof droidspaces >/dev/null 2>&1; then
                echo -e "${GREEN}✅ Droidspaces container restarted successfully!${NC}"
            else
                echo -e "${RED}[!] Container failed to start.${NC}"
            fi
            ;;
        status|*)
            if pidof droidspaces >/dev/null 2>&1; then
                echo -e "Droidspaces: ${GREEN}RUNNING${NC} (Container: my-container, PID: $(pidof droidspaces))"
            else
                echo -e "Droidspaces: ${RED}STOPPED${NC}"
            fi
            ;;
    esac
}

cmd_web() {
    sub="$1"
    case "$sub" in
        start)
            killall httpd 2>/dev/null
            if [ -x "$HTTPD_BIN" ] && [ -d "$WEBROOT" ]; then
                "$HTTPD_BIN" httpd -p 8888 -h "$WEBROOT" 2>/dev/null
                WLAN_IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oE "inet [0-9.]+" | awk '{print $2}')
                echo -e "${GREEN}✅ WebUI Server started on port 8888.${NC}"
                echo -e "   • Local / LAN : http://${WLAN_IP:-127.0.0.1}:8888"
            else
                echo -e "${RED}[!] busybox or webroot missing.${NC}"
            fi
            ;;
        stop)
            pkill -f "busybox httpd" 2>/dev/null
            killall httpd 2>/dev/null
            echo -e "${GREEN}✅ WebUI Server stopped.${NC}"
            ;;
        status|*)
            if pgrep -f "httpd" >/dev/null 2>&1; then
                echo -e "WebUI Server: ${GREEN}RUNNING${NC} (Port 8888)"
            else
                echo -e "WebUI Server: ${YELLOW}STOPPED${NC}"
            fi
            ;;
    esac
}

cmd_touch() {
    sub="$1"
    EV=$(get_touch_event)
    PID=$(pidof touch_blocker 2>/dev/null)
    case "$sub" in
        off|block)
            if [ -n "$PID" ]; then
                echo -e "${YELLOW}[!] Touch is already BLOCKED (PID: $PID).${NC}"
            else
                [ -f "$TOUCH_BIN" ] && "$TOUCH_BIN" "/dev/input/$EV" >> "$TOUCH_LOG" 2>&1 &
                sleep 1
                echo -e "${GREEN}🛡️ Touchscreen BLOCKED on /dev/input/$EV (PID: $(pidof touch_blocker)).${NC}"
            fi
            ;;
        on|unblock)
            if [ -n "$PID" ]; then
                kill -9 $PID 2>/dev/null
                echo -e "${GREEN}✅ Touchscreen UNBLOCKED. Normal touch restored.${NC}"
            else
                echo -e "${YELLOW}[!] Touch is already UNBLOCKED.${NC}"
            fi
            ;;
        toggle)
            if [ -n "$PID" ]; then
                cmd_touch "on"
            else
                cmd_touch "off"
            fi
            ;;
        *)
            if [ -n "$PID" ]; then
                echo -e "Touch Status: ${RED}BLOCKED${NC} (PID: $PID, Device: $EV)"
            else
                echo -e "Touch Status: ${GREEN}UNBLOCKED${NC}"
            fi
            ;;
    esac
}

cmd_trim() {
    echo -e "${YELLOW}[*] Dropping caches and compacting memory...${NC}"
    BEFORE_KB=$(get_mem_kb "MemAvailable")
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
    echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
    AFTER_KB=$(get_mem_kb "MemAvailable")
    AVAIL_MB=$(( AFTER_KB / 1024 ))
    FREED_MB=$(( (AFTER_KB - BEFORE_KB) / 1024 ))
    echo -e "${GREEN}✅ Trim complete! Available RAM: ${BOLD}${AVAIL_MB} MB${NC} (Freed: ~${FREED_MB} MB)"
}

cmd_json() {
    TOTAL_KB=$(get_mem_kb "MemTotal")
    FREE_KB=$(get_mem_kb "MemFree")
    AVAIL_KB=$(get_mem_kb "MemAvailable")
    CACHED_KB=$(get_mem_kb "Cached")
    TOTAL_MB=$((TOTAL_KB / 1024))
    FREE_MB=$((FREE_KB / 1024))
    AVAIL_MB=$((AVAIL_KB / 1024))
    USED_MB=$((TOTAL_MB - AVAIL_MB))
    CACHED_MB=$((CACHED_KB / 1024))
    BATT_TEMP=$(get_batt_temp)
    MODE=$(get_current_mode)
    
    TOUCH_PID=$(pidof touch_blocker 2>/dev/null)
    TOUCH_BLOCKED="false"
    [ -n "$TOUCH_PID" ] && TOUCH_BLOCKED="true"
    
    CAM_HAL=$(getprop init.svc.camerahalserver 2>/dev/null)
    CAM_STOPPED="true"
    [ "$CAM_HAL" = "running" ] && CAM_STOPPED="false"
    
    FP_HAL=$(getprop init.svc.vendor.fps_hal 2>/dev/null)
    FP_KILLED="true"
    [ "$FP_HAL" = "running" ] && FP_KILLED="false"
    
    TOTAL_TARGETS=0
    DISABLED_COUNT=0
    for pkg in $TIER1_PKGS; do
        TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
        if pm list packages -d 2>/dev/null | grep -q "${pkg}$"; then
            DISABLED_COUNT=$((DISABLED_COUNT + 1))
        fi
    done
    
    DS_RUNNING="false"
    pidof droidspaces >/dev/null 2>&1 && DS_RUNNING="true"
    NGINX_RUNNING="false"
    pidof nginx >/dev/null 2>&1 && NGINX_RUNNING="true"
    PM2_RUNNING="false"
    (pidof node >/dev/null 2>&1 || ps -ef | grep -q "pm2") && PM2_RUNNING="true"
    
    VPN_IP=$(get_vpn_ip)
    VPN_CONNECTED="false"
    [ -n "$VPN_IP" ] && VPN_CONNECTED="true"
    
    HTTPD_RUNNING="false"
    pgrep -f "httpd" >/dev/null 2>&1 && HTTPD_RUNNING="true"
    
    cat << JSON
{
  "mode": "${MODE}",
  "ram": {
    "total_mb": ${TOTAL_MB},
    "used_mb": ${USED_MB},
    "free_mb": ${FREE_MB},
    "avail_mb": ${AVAIL_MB},
    "cached_mb": ${CACHED_MB}
  },
  "battery": {
    "temp": ${BATT_TEMP}
  },
  "touch": {
    "blocked": ${TOUCH_BLOCKED},
    "pid": "${TOUCH_PID:-0}"
  },
  "camera": {
    "stopped": ${CAM_STOPPED}
  },
  "fingerprint": {
    "killed": ${FP_KILLED}
  },
  "debloat": {
    "active": $( [ "$MODE" != "normal" ] && echo "true" || echo "false" ),
    "disabled_count": ${DISABLED_COUNT},
    "total_targets": ${TOTAL_TARGETS}
  },
  "vpn": {
    "connected": ${VPN_CONNECTED},
    "ip": "${VPN_IP:-""}"
  },
  "droidspaces": {
    "running": ${DS_RUNNING},
    "nginx": ${NGINX_RUNNING},
    "pm2": ${PM2_RUNNING}
  },
  "web_server": {
    "running": ${HTTPD_RUNNING},
    "port": 8888
  }
}
JSON
}

case "$1" in
    status)
        cmd_status
        ;;
    help|--help|-h)
        cmd_help
        ;;
    mode)
        cmd_mode "$2"
        ;;
    enable|tier1)
        cmd_mode "tier1"
        ;;
    tier2)
        cmd_mode "tier2"
        ;;
    disable|restore|normal)
        cmd_mode "normal"
        ;;
    vpn)
        cmd_vpn "$2"
        ;;
    droidspaces|ds)
        cmd_droidspaces "$2"
        ;;
    web)
        cmd_web "$2"
        ;;
    touch)
        cmd_touch "$2"
        ;;
    trim|clean)
        cmd_trim
        ;;
    fp)
        if [ "$2" = "clean" ]; then
            rm -f /data/tombstones/*fingerprint* 2>/dev/null
            echo -e "${GREEN}✅ Fingerprint crash tombstones cleaned!${NC}"
        else
            cmd_status
        fi
        ;;
    back|nav)
        input keyevent 4
        echo -e "${GREEN}◀ Android Back keyevent sent.${NC}"
        ;;
    home)
        am start -n com.rifsxd.ksunext/.ui.webui.WebUIActivity -d "kernelsu://webui/frenzy_server" >/dev/null 2>&1 || am start -n com.rifsxd.ksunext/.ui.MainActivity >/dev/null 2>&1
        echo -e "${GREEN}🏠 Returned to FrenzyServer WebUI.${NC}"
        ;;
    json)
        cmd_json
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
